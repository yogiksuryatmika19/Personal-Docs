{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Home","text":"<p>For full documentation visit mkdocs.org.</p>"},{"location":"#commands","title":"Commands","text":"<ul> <li><code>mkdocs new [dir-name]</code> - Create a new project.</li> <li><code>mkdocs serve</code> - Start the live-reloading docs server.</li> <li><code>mkdocs build</code> - Build the documentation site.</li> <li><code>mkdocs -h</code> - Print help message and exit.</li> </ul>"},{"location":"#project-layout","title":"Project layout","text":"<pre><code>mkdocs.yml    # The configuration file.\ndocs/\n    index.md  # The documentation homepage.\n    ...       # Other markdown pages, images and other files.\n</code></pre>"},{"location":"HTML/Atribut/","title":"Atribut","text":""},{"location":"HTML/Atribut/#id","title":"id","text":""},{"location":"HTML/Atribut/#class","title":"class","text":""},{"location":"HTML/Atribut/#name","title":"name","text":""},{"location":"HTML/Audio/","title":"Audio","text":""},{"location":"HTML/Audio/#audio","title":"Audio","text":""},{"location":"HTML/Audio/#audio-atribut","title":"Audio Atribut","text":""},{"location":"HTML/Audio/#example","title":"Example","text":""},{"location":"HTML/Block%20%26%20Inline/","title":"Block & Inline","text":""},{"location":"HTML/Block%20%26%20Inline/#block","title":"Block","text":""},{"location":"HTML/Block%20%26%20Inline/#inline","title":"Inline","text":""},{"location":"HTML/Button/","title":"Button","text":""},{"location":"HTML/Button/#button","title":"Button","text":""},{"location":"HTML/Button/#button-atribut","title":"Button Atribut","text":""},{"location":"HTML/Button/#example","title":"Example","text":""},{"location":"HTML/Comment/","title":"Comment","text":""},{"location":"HTML/Comment/#one-line-comment","title":"One Line Comment","text":""},{"location":"HTML/Comment/#multi-line-comment","t